NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_PROJECT_ID="<id>"


DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Email (Resend) — used for email-OTP login/checkout and transactional email
RESEND_API_KEY=
EMAIL_FROM="Tanvira <onboarding@resend.dev>"

# Payments (Cashfree) — sandbox keys for local/preview
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
NEXT_PUBLIC_CASHFREE_ENV=sandbox

# Shared secret checked by /api/orders/[id]/ship — entered once into the
# Sanity Studio "Ship Order" tool by the owner (no admin role exists otherwise)
ADMIN_API_SECRET=

# Sanity — write access for the seed script only (never exposed to the client)
SANITY_API_TOKEN=